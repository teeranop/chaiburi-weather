# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า (ไฟล์ .env ไม่ถูก commit) — ใช้เฉพาะตอนรันในเครื่อง
# บน GitHub Actions ใช้ค่าจาก Settings → Secrets and variables → Actions
# เว้นว่างไว้ = ไม่ใช้แหล่งนั้น

# พื้นที่น้ำท่วมจากดาวเทียม (https://api-gateway.gistda.or.th)
GISTDA_API_KEY=

# พยากรณ์ NWP ของกรมอุตุฯ (https://data.tmd.go.th/nwpapi)
TMD_NWP_TOKEN=

# ช่องทางแจ้งเตือน — ถ้าใส่ไว้ให้รันด้วย --no-telegram ระหว่างทดสอบ ไม่งั้นจะส่งแจ้งเตือนจริง
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MOPH_CLIENT_ID=
MOPH_SECRET=
